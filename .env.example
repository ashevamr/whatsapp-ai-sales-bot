# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard port (http://localhost:8888)
PORT=8888

# Supervisor WhatsApp number, international format without "+".
# Receives [HANDOVER] alerts from the AI.
SUPERVISOR_PHONE=77012345678

# Owner number that receives takeover / "client may leave" / sale alerts.
TAKEOVER_OWNER_PHONE=77012345678

# Exact name of the internal WhatsApp group with closed deals, used by the
# "successful sales" analysis in the dashboard.
SUCCESS_CASES_GROUP_NAME=Заявки
